{
  "expo": {
    "name": "VYBE",
    "slug": "vybev2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vybe.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0F"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "pan",
      "predictiveBackGestureEnabled": false,
      "package": "com.vybe.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      [
        "expo-image-picker",
        {
          "photosPermission": "O VYBE precisa acessar suas fotos para você postar na festa.",
          "cameraPermission": "O VYBE precisa da câmera para você capturar o momento."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O VYBE usa sua localização para mostrar onde as pessoas estão e conectar você com quem está perto.",
          "locationWhenInUsePermission": "O VYBE usa sua localização para mostrar onde as pessoas estão."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#FF2D78",
          "defaultChannel": "default",
          "sounds": []
        }
      ]
    ],
    "scheme": "vybe",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cddff45a-f1b3-4292-8b52-35145bd54884"
      }
    },
    "owner": "nekoide"
  }
}
